# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5433/warraich_motors?schema=public"

# Auth Secret (generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-secure-random-32-byte-secret-key"

# Application Settings
NEXT_PUBLIC_APP_NAME="Warraich Motors Gujrat"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_CURRENCY="PKR"

# Business Information
BUSINESS_NAME="Warraich Motors Gujrat"
BUSINESS_LOCATION="GT Road, Gujrat, Punjab, Pakistan"
BUSINESS_PHONE="+92 300 1234567"
BUSINESS_EMAIL="info@warraichmotors.pk"

# Storage (Cloudinary or compatible S3/CDN)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
